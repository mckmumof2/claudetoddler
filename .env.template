# Web Scraping Tools Configuration Template
# Copy this to .env and fill in your keys

# ============ ScrapeGraphAI LLM Configuration ============
# Choose ONE of the following:

# Option 1: OpenAI (GPT-4, GPT-4o-mini)
# OPENAI_API_KEY=sk-...

# Option 2: Groq (Free tier available, fast, 7500 RPM limit)
# GROQ_API_KEY=gsk_...
# Get free key: https://console.groq.com

# Option 3: Azure OpenAI
# AZURE_API_KEY=...
# AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/

# Option 4: Google Gemini
# GOOGLE_API_KEY=...

# Option 5: ScrapeGraphAI Managed API (Premium, fully managed)
# SGAI_API_KEY=sgai_...
# Get from: https://scrapegraphai.com

# Option 6: Local Ollama (Free, runs locally, slower)
# OLLAMA_MODEL=llama2  # Install Ollama from https://ollama.ai

# ============ Agent Reach Platform Credentials ============
# These require Cookie-Editor browser extension or CLI setup
# NOT auto-populated — add only what you need

# Twitter/X (if using Agent Reach)
# TWITTER_AUTH_TOKEN=...
# TWITTER_CT0=...

# For other platforms (Reddit, TikTok, Instagram, Facebook, 小红书):
# Use: agent-reach configure <platform> or Cookie-Editor browser extension
# See ~/.claude/skills/agent-reach-SKILL.md for instructions

# ============ Scrapling Configuration (Optional) ============
# SCRAPLING_PROXY_FILE=/path/to/proxies.txt
# SCRAPLING_HEADLESS=true
# SCRAPLING_TIMEOUT=30
